datasource db {
  provider = "postgresql"
}

// 1. Lifecycle states for a duel
enum BattleStatus {
  PENDING
  IN_PROGRESS
  EVALUATING
  COMPLETED
  DECLINED
}

// 2. User account model
model User {
  id           String    @id @default(uuid())
  username     String    @unique
  email        String    @unique
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  deletedAt    DateTime? @map("deleted_at")

  // Relations
  // Since User relates to Battle 3 different ways, we give each a custom relation name
  battlesChallenged Battle[]     @relation("ChallengerBattles")
  battlesReceived   Battle[]     @relation("OpponentBattles")
  battlesWon        Battle[]     @relation("WonBattles")
  submissions       Submission[]

  @@map("users")
}

// 3. The grammar duel arena
model Battle {
  id             String       @id @default(uuid())
  grammarTopic   String       @map("grammar_topic")
  promptSentence String       @map("prompt_sentence") @db.Text
  status         BattleStatus @default(PENDING)
  llmFeedback    String?      @map("llm_feedback") @db.Text

  // Foreign Keys & Relations
  challengerId String @map("challenger_id")     
  challenger   User   @relation("ChallengerBattles", fields: [challengerId], references: [id], onDelete: Cascade)

  opponentId String @map("opponent_id")
  opponent   User   @relation("OpponentBattles", fields: [opponentId], references: [id], onDelete: Cascade)

  winnerId String? @map("winner_id")
  winner   User?   @relation("WonBattles", fields: [winnerId], references: [id], onDelete: SetNull)

  submissions Submission[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("battles")
}

// 4. Player translations
model Submission {
  id              String   @id @default(uuid())
  translationText String   @map("translation_text") @db.Text
  submittedAt     DateTime @default(now()) @map("submitted_at")

  // Foreign Keys & Relations
  battleId String @map("battle_id")
  battle   Battle @relation(fields: [battleId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // CRITICAL: A player cannot submit twice to the same duel
  @@unique([battleId, userId])
  @@map("submissions")
}
